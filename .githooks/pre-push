#!/bin/sh
# Block direct pushes to main. Use a branch and a pull request.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: direct push to ${remote_ref#refs/heads/} is blocked. Push a branch and open a PR." >&2
      exit 1 ;;
  esac
done
exit 0
