{
  // Developer tasks for this repository. Rule (CLAUDE.md "Dev tasks"):
  // every new command (CLI command, check, or script) gets a task here in the same PR.
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/api"
  },
  "tasks": [
    {
      "label": "api: sync",
      "detail": "Install Python and dependencies (uv sync).",
      "type": "shell",
      "command": "uv sync",
      "problemMatcher": []
    },
    {
      "label": "api: run",
      "detail": "Start the API on http://127.0.0.1:8000 with reload.",
      "type": "shell",
      "command": "uv run cerberus api --reload",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "api: doctor",
      "detail": "Check that this machine can run Cerberus.",
      "type": "shell",
      "command": "uv run cerberus doctor",
      "problemMatcher": []
    },
    {
      "label": "learn: check",
      "detail": "Check the learning index (docs/learn/index.yaml, concepts/*.yaml) offline (schema, ids, https, domains, primary sources).",
      "type": "shell",
      "command": "uv run python scripts/learn_index.py check",
      "problemMatcher": []
    },
    {
      "label": "learn: check-links",
      "detail": "Check the learning index offline rules, then request every source URL.",
      "type": "shell",
      "command": "uv run python scripts/learn_index.py check --online",
      "problemMatcher": []
    },
    {
      "label": "learn: edit",
      "detail": "Start the learning index editor on http://127.0.0.1:8765.",
      "type": "shell",
      "command": "uv run python scripts/learn_editor.py",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "api: lint",
      "detail": "Ruff lint.",
      "type": "shell",
      "command": "uv run ruff check .",
      "problemMatcher": []
    },
    {
      "label": "api: format",
      "detail": "Ruff format (writes changes).",
      "type": "shell",
      "command": "uv run ruff format .",
      "problemMatcher": []
    },
    {
      "label": "api: format-check",
      "detail": "Ruff format check (no changes, same as CI).",
      "type": "shell",
      "command": "uv run ruff format --check .",
      "problemMatcher": []
    },
    {
      "label": "api: typecheck",
      "detail": "ty type check.",
      "type": "shell",
      "command": "uv run ty check",
      "problemMatcher": []
    },
    {
      "label": "api: test",
      "detail": "Run pytest.",
      "type": "shell",
      "command": "uv run pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "repo: prune-branches",
      "detail": "Fetch with prune, then delete local branches already merged into origin/main.",
      "type": "shell",
      "command": "git fetch --prune origin && git branch --merged origin/main --format='%(refname:short)' | grep -vE '^main$' | xargs -r git branch -d",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GIT_CONFIG_COUNT": "1",
          "GIT_CONFIG_KEY_0": "safe.directory",
          "GIT_CONFIG_VALUE_0": "${workspaceFolder}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "api: style-check",
      "detail": "Project style rules: Intent lines, headers, size flags, 70-line functions, no built-in raises.",
      "type": "shell",
      "command": "uv run python scripts/style_check.py",
      "problemMatcher": []
    },
    {
      "label": "repo: outline",
      "detail": "Map of the code: each file's Intent line and each function's summary line.",
      "type": "shell",
      "command": "uv run python scripts/style_check.py --outline src scripts",
      "problemMatcher": []
    },
    {
      "label": "api: check",
      "detail": "All CI checks in order: lint, format-check, typecheck, style-check, learn-check, test.",
      "dependsOrder": "sequence",
      "dependsOn": ["api: lint", "api: format-check", "api: typecheck", "api: style-check", "learn: check", "api: test"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
